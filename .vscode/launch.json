    "version": "0.2.0",
    "configurations": [
        {
            "name": "GD32F4xx Launch",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/gd32f4xx.elf",
            "device": "GD32F450IK",
            "interface": "swd",
            "svdFile": "${workspaceRoot}/tools/svd/GD32F4xx.svd",
            "runToEntryPoint": "main",
        },
        {
            "name": "GD32F4xx Attach",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "jlink",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/gd32f4xx.elf",
            "device": "GD32F450IK",
            "interface": "swd",
            "svdFile": "${workspaceRoot}/tools/svd/GD32F4xx.svd",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw"
        },
    ]
}